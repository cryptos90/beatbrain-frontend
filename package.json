{
  "name": "beatbrain-frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npm run start:lan",
    "start:lan": "expo start --lan --port 8081 --clear",
    "start:tunnel": "expo start --tunnel --port 8081 --clear",
    "start:web": "expo start --web --port 8081 --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-community/slider": "^5.1.2",
    "expo": "~54.0.30",
    "expo-asset": "~12.0.12",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "^8.0.11",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "typescript": "~5.9.2"
  },
